# Copie para .env e preencha. O .env NÃO vai para o git.

# GitHub: opcional se o `gh` CLI estiver autenticado (sem nenhum dos dois: 60 req/h).
GITHUB_TOKEN=

# Jev (TypeSafe). Sem chave, o Jev simplesmente não é usado.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Ollama (resumo e baseline "só LLM").
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
# Contexto do Ollama em tokens (o padrão dele, 4096, falha em issues longas).
OLLAMA_NUM_CTX=16384
